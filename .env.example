# Required: Your Web3Forms access key for email delivery.
# Get one free at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# Optional: Google Business short link shown after a 4-5 star rating.
# If not set, the "Leave a Review" button will not appear.
VITE_GOOGLE_REVIEW_URL=https://g.page/r/YOUR_GOOGLE_REVIEW_LINK/review
